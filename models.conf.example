# ~/opencode/models.conf
# 模型配置文件 - 复制为 models.conf 并按需修改
# 格式: KEY=value (不要加引号)

# =========================================
# 主模型 (opencode.json)
# =========================================

# OpenCode 默认使用的模型
MAIN_MODEL=opencode/claude-opus-4-5

# =========================================
# Agent 模型 (oh-my-opencode.json)
# =========================================

# Planner-Sisyphus - 规划代理（主编排器）
PLANNER_MODEL=opencode/claude-opus-4-5

# Oracle - 技术顾问（深度思考、架构设计）
# ORACLE_MODEL=opencode/gpt-5.2

# Librarian - 文档研究专家
# LIBRARIAN_MODEL=opencode/claude-haiku-4-5

# Explore - 代码搜索专家（免费）
# EXPLORE_MODEL=opencode/grok-code

# Document Writer - 文档写作专家
# DOCUMENT_WRITER_MODEL=opencode/gemini-3-flash

# Frontend UI/UX Engineer - 前端专家
# FRONTEND_MODEL=opencode/gemini-3-pro

# Multimodal Looker - 多媒体分析（PDF、图片、图表）
# MULTIMODAL_MODEL=opencode/gemini-3-flash

# =========================================
# 可用模型列表
# =========================================
#
# OpenCode 代理（推荐，自动路由）:
#   - opencode/claude-opus-4-5      (最强)
#   - opencode/claude-sonnet-4-5    (快速)
#   - opencode/claude-haiku-4-5     (轻量)
#   - opencode/gpt-5.2              (推理)
#   - opencode/gpt-4.1
#   - opencode/gemini-3-pro
#   - opencode/gemini-3-flash
#   - opencode/grok-code            (免费)
#
# 厂商直连（需要对应 API Key）:
#   - anthropic/claude-opus-4-5
#   - anthropic/claude-sonnet-4-5
#   - openai/gpt-5.2
#   - openai/gpt-4.1
#   - google/gemini-3-pro-preview
#   - google/gemini-3-flash
#
# Quotio (需要 --quotio 启动):
#   - quotio/gemini-claude-opus-4-5-thinking
#   - quotio/gemini-claude-sonnet-4-5
#   - quotio/gemini-3-pro-preview
#   - quotio/gpt-5.2
