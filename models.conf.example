# ~/opencode/models.conf
# 模型配置文件 - 复制为 models.conf 并按需修改
# 格式: KEY=value (不要加引号)

# =========================================
# 主模型 (opencode.json)
# =========================================

# OpenCode 默认使用的模型
MAIN_MODEL=anthropic/claude-opus-4-5

# =========================================
# Agent 模型 (oh-my-opencode.json)
# =========================================

# Planner-Sisyphus - 规划代理（主编排器）
PLANNER_MODEL=anthropic/claude-opus-4-5

# Oracle - 技术顾问（深度思考、架构设计）
# 默认未设置，建议设置为推理模型
# ORACLE_MODEL=openai/gpt-5.2

# Document Writer - 文档写作专家
# 默认未设置，--quotio 模式下自动使用 quotio/gemini-3-pro-preview
# DOCUMENT_WRITER_MODEL=quotio/gemini-3-pro-preview

# Frontend UI/UX Engineer - 前端专家
# 默认未设置，--quotio 模式下自动使用 quotio/gemini-3-pro-preview
# FRONTEND_MODEL=quotio/gemini-3-pro-preview

# Multimodal Looker - 多媒体分析（PDF、图片、图表）
# 默认未设置，--quotio 模式下自动使用 quotio/gemini-3-flash-preview
# MULTIMODAL_MODEL=quotio/gemini-3-flash-preview

# =========================================
# 可用模型列表
# =========================================
#
# Anthropic:
#   - anthropic/claude-opus-4-5      (最强，默认)
#   - anthropic/claude-sonnet-4-5    (快速)
#
# OpenAI:
#   - openai/gpt-5.2                 (推理)
#   - openai/gpt-4.1
#
# Quotio (需要 --quotio 启动):
#   - quotio/gemini-claude-opus-4-5-thinking
#   - quotio/gemini-claude-sonnet-4-5
#   - quotio/gemini-3-pro-preview
#   - quotio/gemini-3-flash-preview
#   - quotio/gpt-5.2
