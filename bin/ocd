#!/usr/bin/env bash
# bin/ocd - OCD v5 主入口

set -euo pipefail

OCD_ROOT="${OCD_ROOT:-$HOME/opencode}"

OCD_DEV_MODE="${OCD_DEV_MODE:-0}"
_OCD_ORIG_ROOT="$OCD_ROOT"
_OCD_DEV_ROOT_ARG=""

_ocd_args=("$@")
_ocd_i=0
while [[ $_ocd_i -lt ${#_ocd_args[@]} ]]; do
  _arg="${_ocd_args[$_ocd_i]}"
  case "$_arg" in
    --dev)
      OCD_DEV_MODE=1
      ;;
    --dev-root=*)
      _OCD_DEV_ROOT_ARG="${_arg#*=}"
      OCD_DEV_MODE=1
      ;;
    --dev-root)
      _ocd_i=$((_ocd_i + 1))
      _OCD_DEV_ROOT_ARG="${_ocd_args[$_ocd_i]:-}"
      OCD_DEV_MODE=1
      ;;
  esac
  _ocd_i=$((_ocd_i + 1))
done
unset _ocd_args _ocd_i _arg

if [[ "$OCD_DEV_MODE" -eq 1 ]]; then
  if [[ "${OCD_ROOT_PRESET:-0}" -ne 1 ]]; then
    _OCD_DEV_ROOT_ARG="${_OCD_DEV_ROOT_ARG/#\~/$HOME}"
    OCD_ROOT="${_OCD_DEV_ROOT_ARG:-$OCD_ROOT/dev}"
  fi

  if [[ ! -d "$OCD_ROOT/lib" ]]; then
    echo "❌ 开发目录不存在或不完整: $OCD_ROOT"
    echo ""
    echo "   创建方法："
    echo "   git worktree add dev dev"
    echo "   # 或"
    echo "   cp -r ~/opencode ~/opencode/dev"
    exit 1
  fi
  export OCD_DEV_MODE
fi
unset _OCD_DEV_ROOT_ARG

source "$OCD_ROOT/lib/core.sh"
source "$OCD_ROOT/lib/port.sh"
source "$OCD_ROOT/lib/workspace.sh"
source "$OCD_ROOT/lib/watcher.sh"
source "$OCD_ROOT/lib/config.sh"
source "$OCD_ROOT/lib/docker.sh"
[[ -f "$OCD_ROOT/lib/migrate.sh" ]] && source "$OCD_ROOT/lib/migrate.sh"

if [[ "${OCD_DEV_MODE:-0}" -eq 1 ]]; then
  IMAGE_NAME="opencode-bun-dev"
else
  IMAGE_NAME="opencode-bun"
fi

if [[ "${OCD_DEV_MODE:-0}" -eq 1 && -f "$OCD_ROOT/.env" ]]; then
  ENV_FILE="$OCD_ROOT/.env"
else
  ENV_FILE="$_OCD_ORIG_ROOT/.env"
fi

_OCD_WATCHER_PID=""
_OCD_HTTPS_ENABLED=""
_OCD_CAFFEINATE_PID=""
_OCD_URL_FILE=""

_ocd_cleanup() {
  local ipc_dir=""
  if [[ -n "$_OCD_URL_FILE" ]]; then
    ipc_dir=$(dirname "$_OCD_URL_FILE")
  fi

  if [[ -n "$_OCD_WATCHER_PID" ]]; then
    kill -TERM -- -"$_OCD_WATCHER_PID" 2>/dev/null
    kill -TERM "$_OCD_WATCHER_PID" 2>/dev/null
    sleep 0.1
    kill -KILL -- -"$_OCD_WATCHER_PID" 2>/dev/null
    kill -KILL "$_OCD_WATCHER_PID" 2>/dev/null
    _OCD_WATCHER_PID=""
  fi

  [[ -n "$ipc_dir" ]] && pkill -f "fswatch.*${ipc_dir}" 2>/dev/null || true

  if [[ -n "$_OCD_URL_FILE" && -f "$_OCD_URL_FILE" ]]; then
    : > "$_OCD_URL_FILE"
    rm -f "${ipc_dir}/.watcher.pid" 2>/dev/null
  fi
  if [[ -n "$_OCD_CAFFEINATE_PID" ]]; then
    kill "$_OCD_CAFFEINATE_PID" 2>/dev/null
    _OCD_CAFFEINATE_PID=""
  fi
  if [[ -n "$_OCD_HTTPS_ENABLED" ]]; then
    tailscale serve --https=443 off &>/dev/null
    _OCD_HTTPS_ENABLED=""
  fi
}

main() {
  [[ -f "$OCD_ROOT/.ocdrc" ]] && source "$OCD_ROOT/.ocdrc"

  # Handle subcommands first
  case "${1:-}" in
    scan)
      shift
      source "$OCD_ROOT/lib/scan.sh"
      ocd_scan "$@"
      return 0
      ;;
    touch)
      shift
      source "$OCD_ROOT/lib/scan.sh"
      ocd_touch "$@"
      return 0
      ;;
    init)
      shift
      ocd_init_project "${1:-full}"
      return 0
      ;;
    config)
      shift
      case "${1:-}" in
        edit)
          shift
          ocd_edit_config "${1:-opencode}"
          ;;
        *)
          ocd_show_config
          ;;
      esac
      return 0
      ;;
  esac

  local REBUILD=0 CLEAN_CONFIG=0
  local CUSTOM_PORT=""
  local USE_QUOTIO=0
  local USE_HERE=0 USE_HTTPS=0 USE_AWAKE=0

  trap '_ocd_cleanup' INT TERM HUP

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v|--version) echo "OCD v$(ocd_version)"; return 0 ;;
      -r) REBUILD=1; shift ;;
      --quotio) USE_QUOTIO=1; shift ;;
      --https) USE_HTTPS=1; shift ;;
      --awake) USE_AWAKE=1; shift ;;
      --debug) OCD_DEBUG=1; export OCD_DEBUG; shift ;;
      --dev) shift ;;
      --dev-root=*) shift ;;
      --dev-root) shift 2 ;;
      -p) CUSTOM_PORT="$2"; shift 2 ;;
      --here) USE_HERE=1; shift ;;
      --clean) CLEAN_CONFIG=1; shift ;;
      -h|--help)
        cat << EOF
OCD v$(ocd_version) - OpenCode Docker

Usage: ocd [command] [options]

Commands:
  scan [目录]         Scan and register git projects to OpenCode
  init [--minimal]    Initialize project configuration
  config              Show configuration paths
  config edit         Edit opencode.json
  config edit --plugin  Edit oh-my-opencode.json

Options:
  -v, --version     Show version
  -r                Rebuild image and clear cache
  -p <port>         Port number
  --here            Mount current directory only (skip workspace detection)
  --clean           Reset global config (backup and regenerate)
  --https           Enable HTTPS via Tailscale Serve
  --awake           Prevent Mac from sleeping
  --quotio          Enable Quotio provider
  --debug           Enable debug output
  --dev             Use development version (from dev/ directory)
  --dev-root PATH   Specify development directory
  -h, --help        Show this help
EOF
        return 0
        ;;
      *) break ;;
    esac
  done

  local CURRENT_DIR WORKSPACE_ROOT START_DIR
  CURRENT_DIR="$(pwd)"

  if [[ "$USE_HERE" -eq 1 ]]; then
    WORKSPACE_ROOT="$CURRENT_DIR"
    START_DIR=""
  else
    WORKSPACE_ROOT=$(ocd_find_workspace_root "$CURRENT_DIR")
    if [[ "$WORKSPACE_ROOT" == BLOCKED:* ]]; then
      ocd_error "工作区 ${WORKSPACE_ROOT#BLOCKED:} 不在白名单内"
      ocd_info "允许的工作区: ${OCD_ALLOWED_WORKSPACES:-未设置}"
      ocd_info "使用 --here 可跳过白名单检查"
      return 1
    fi
    START_DIR=$(ocd_get_relative_path "$WORKSPACE_ROOT" "$CURRENT_DIR")
  fi

  local WORKSPACE_NAME
  WORKSPACE_NAME=$(ocd_sanitize_name "$(basename "$WORKSPACE_ROOT")")
  local CONTAINER_NAME="opencode-${WORKSPACE_NAME}"
  [[ "${OCD_DEV_MODE:-0}" -eq 1 ]] && CONTAINER_NAME="${CONTAINER_NAME}-dev"

  ocd_load_versions

  if [[ "$CLEAN_CONFIG" -eq 1 ]]; then
    ocd_reset_global_config
    return 0
  fi

  local PORT
  PORT="${CUSTOM_PORT:-$(ocd_find_free_port 4096)}"

  ocd_debug "OCD_CACHE_HOME=$OCD_CACHE_HOME"
  ocd_debug "OCD_CONFIG_HOME=$OCD_CONFIG_HOME"
  ocd_debug "WORKSPACE_ROOT=$WORKSPACE_ROOT"
  ocd_debug "PORT=$PORT"

  if [[ "$REBUILD" -eq 1 ]]; then
    ocd_remove_image "$IMAGE_NAME"
    echo "🗑️  清理缓存..."
    ocd_debug "删除缓存目录: $OCD_CACHE_HOME"
    rm -rf "$OCD_CACHE_HOME" "$OCD_OMO_CACHE_HOME"
    mkdir -p "$OCD_OMO_CACHE_HOME/bin" "$OCD_CACHE_HOME/ms-playwright"
    ocd_build_image "$IMAGE_NAME" 1
  elif ! ocd_image_exists "$IMAGE_NAME"; then
    ocd_build_image "$IMAGE_NAME" 0
  fi

  ocd_check_dependencies

  # v5: Ensure global config exists (first-time creation only)
  ocd_ensure_global_config

  # v5: Check migration from v4
  if type ocd_check_migration &>/dev/null; then
    ocd_check_migration "$CURRENT_DIR"
  fi
  
  # v5: Check Claude global storage migration
  if type ocd_check_claude_migration &>/dev/null; then
    ocd_check_claude_migration
  fi

  # v5: Show welcome on first run
  ocd_show_welcome_if_first_run

  ocd_init_global
  mkdir -p "$OCD_OMO_CACHE_HOME/bin" "$OCD_CACHE_HOME/ms-playwright"
  ocd_ensure_provider_cache

  ocd_load_env "$ENV_FILE"

  # v5: Only update port (config already exists)
  local CONFIG_FILE="${OCD_CONFIG_HOME}/opencode.json"

  ocd_update_port "$CONFIG_FILE" "$PORT"

  # v5: Apply models.conf if exists (optional override)
  if [[ -f "$OCD_ROOT/models.conf" ]]; then
    ocd_apply_models_conf
  fi

  local IPC_DIR
  IPC_DIR=$(ocd_ipc_dir "$PORT")
  mkdir -p "$IPC_DIR"
  local URL_FILE="${IPC_DIR}/open_url"
  local NOTIFY_FILE="${IPC_DIR}/notifications"
  local CLIPBOARD_FILE="${IPC_DIR}/clipboard"
  : > "$URL_FILE" && : > "$NOTIFY_FILE" && : > "$CLIPBOARD_FILE"
  _OCD_URL_FILE="$URL_FILE"

  local WATCHER_PID_FILE="${IPC_DIR}/.watcher.pid"
  if [[ -f "$WATCHER_PID_FILE" ]]; then
    local old_pid
    old_pid=$(cat "$WATCHER_PID_FILE" 2>/dev/null)
    if [[ -n "$old_pid" ]]; then
      kill -TERM -- -"$old_pid" 2>/dev/null || true
      kill -TERM "$old_pid" 2>/dev/null || true
    fi
    rm -f "$WATCHER_PID_FILE"
  fi
  pkill -f "fswatch.*${IPC_DIR}" 2>/dev/null || true

  ocd_start_watcher "$URL_FILE" "$NOTIFY_FILE" "$CLIPBOARD_FILE"
  echo "$_OCD_WATCHER_PID" > "$WATCHER_PID_FILE"

  local TS_HOSTNAME=""
  if [[ "$USE_HTTPS" -eq 1 ]] && command -v tailscale &>/dev/null; then
    TS_HOSTNAME=$(tailscale status --json 2>/dev/null | grep -o '"Self":{[^}]*"DNSName":"[^"]*"' | grep -o '"DNSName":"[^"]*"' | cut -d'"' -f4 | sed 's/\.$//' || echo "")
    if [[ -n "$TS_HOSTNAME" ]]; then
      tailscale serve --bg https / "http://localhost:${PORT}" &>/dev/null || true
      _OCD_HTTPS_ENABLED=1
    fi
  fi

  local dev_label=""
  [[ "${OCD_DEV_MODE:-0}" -eq 1 ]] && dev_label=" [DEV]"
  echo ""
  echo "🚀 OCD v$(ocd_version)${dev_label} │ http://localhost:${PORT}"
  [[ "${OCD_DEV_MODE:-0}" -eq 1 ]] && echo "   └─ 📂 开发目录: $OCD_ROOT"
  local TAILSCALE_IP
  TAILSCALE_IP=$(ocd_get_tailscale_ip || echo "")
  [[ -n "$TS_HOSTNAME" && "$USE_HTTPS" -eq 1 ]] && echo "   └─ 🔒 HTTPS: https://${TS_HOSTNAME}"
  [[ -z "$TS_HOSTNAME" && -n "$TAILSCALE_IP" ]] && echo "   └─ 📱 远程: http://${TAILSCALE_IP}:${PORT}"
  [[ "$USE_QUOTIO" -eq 1 ]] && echo "   └─ Quotio 已启用"
  [[ -n "$START_DIR" ]] && echo "   └─ 项目: ${START_DIR%%/*}"
  [[ "$USE_AWAKE" -eq 1 ]] && echo "   └─ ☕ 防休眠已启用"
  echo ""

  if [[ "$USE_AWAKE" -eq 1 ]]; then
    caffeinate -i -w $$ &
    _OCD_CAFFEINATE_PID=$!
  fi

  ocd_run_container "$CONTAINER_NAME" "$IMAGE_NAME" "$WORKSPACE_ROOT" "$PORT" "$START_DIR" "$ENV_FILE" "$@"

  _ocd_cleanup
}

main "$@"
