#!/bin/bash
# bin/devocd - 开发模式快捷入口

OCD_DEV_ROOT="${OCD_DEV_ROOT:-$HOME/opencode/dev}"

if [[ ! -f "$OCD_DEV_ROOT/bin/ocd" ]]; then
  echo "❌ 开发目录不存在: $OCD_DEV_ROOT"
  echo ""
  echo "   创建方法："
  echo "   cd ~/opencode && git worktree add dev dev"
  exit 1
fi

export OCD_ROOT="$OCD_DEV_ROOT"
export OCD_ROOT_PRESET=1
export OCD_DEV_MODE=1
export OCD_CONFIG_HOME="${OCD_DEV_CONFIG:-$HOME/.config/opencode-dev}"

exec "$OCD_DEV_ROOT/bin/ocd" "$@"
