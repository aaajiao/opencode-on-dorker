{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "plugin": [
    "oh-my-opencode@{{OH_MY_OPENCODE_VERSION}}",
    "opencode-antigravity-auth@latest"
  ],
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@{{PLAYWRIGHT_MCP_VERSION}}", "--headless"],
      "enabled": true
    },
    "kernel": {
      "type": "remote",
      "url": "https://mcp.onkernel.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:KERNEL_API_KEY}"
      },
      "enabled": false
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server@{{EXA_MCP_VERSION}}"],
      "enabled": false,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    }
  }
}
