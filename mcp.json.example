{
  "_comment": "MCP 服务器配置 - 复制为 mcp.json 并按需修改",
  "_variables": "支持 ${VAR} 和 ${VAR:-default} 格式，从 versions.lock 和 .env 读取",

  "playwright": {
    "type": "local",
    "command": ["npx", "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION:-0.0.55}", "--headless"],
    "enabled": true
  },
  "exa": {
    "type": "local",
    "command": ["npx", "-y", "exa-mcp-server@${EXA_MCP_VERSION:-3.1.3}"],
    "timeout": 60000,
    "enabled": false,
    "environment": {
      "EXA_API_KEY": "${EXA_API_KEY}"
    }
  }
}
