# ================================================
# OCD (OpenCode Docker) 版本锁定文件
# ================================================
#
# 升级方式：
#   镜像内置 → 改版本后运行 ocd -r
#   运行时安装 → 改版本后运行 ocd --clean 并清缓存:
#               rm -rf ~/.cache/opencode/node_modules ~/.cache/opencode/bun.lock
#
# ================================================

# ================================================
# 镜像内置 (ocd -r)
# ================================================

# Docker 基础镜像
BUN_VERSION=1.3.5

# OpenCode 核心 CLI
OPENCODE_AI_VERSION=1.1.28

# Python 依赖
PIP_REQUESTS=2.32.5
PIP_PANDAS=2.2.3
PIP_NUMPY=2.2.1
PIP_MATPLOTLIB=3.10.0
PIP_BEAUTIFULSOUP4=4.12.3
PIP_PILLOW=11.1.0

# NotebookLM Skill
PIP_NOTEBOOKLM_PY=0.2.0

# ================================================
# 运行时安装 (ocd --clean + 清缓存)
# ================================================

# OpenCode 插件
OH_MY_OPENCODE_VERSION=2.14.0
OPENCODE_ANTIGRAVITY_AUTH_VERSION=1.3.1-beta.0
